def _human_count(n):
    """Compact human form of a count: 15000000 → ``15.0M``, 9800 → ``9.8K``."""
    if n >= 1_000_000:
        return f'{n / 1_000_000:.1f}M'
    if n >= 1_000:
        return f'{n / 1_000:.1f}K'
    return str(n)


def _total_tokens_left(a):
